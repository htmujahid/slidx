# Convex deployment used by `npx convex dev` (written by the CLI).
CONVEX_DEPLOYMENT=

NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# AI assistant (app/api/chat/route.ts)
OPENAI_API_KEY=
# Optional. Defaults to gpt-5.4-mini.
OPENAI_MODEL=

# Read by the Convex backend (convex/), not by Next.js. Set them on the
# deployment instead of here:
#   npx convex env set SITE_URL http://localhost:3000
#   npx convex env set GOOGLE_CLIENT_ID <value>
#   npx convex env set GOOGLE_CLIENT_SECRET <value>

# Public origin used for canonical URLs, sitemap and social images, e.g.
# https://visx.app. Falls back to Vercel's production URL, then localhost.
NEXT_PUBLIC_SITE_URL=
